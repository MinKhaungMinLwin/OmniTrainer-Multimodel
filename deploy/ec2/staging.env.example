# Public endpoints. Point both DNS A records at the EC2 Elastic IP first.
API_DOMAIN=api.example.com
VOICE_DOMAIN=voice.example.com
WEB_ORIGIN=https://your-project.vercel.app
ACME_EMAIL=operations@example.com

# Data-service credentials. Generate independent random values; do not reuse examples.
POSTGRES_DB=omni
POSTGRES_USER=omni
POSTGRES_PASSWORD=generate-a-random-alphanumeric-value
MINIO_ROOT_USER=omni
MINIO_ROOT_PASSWORD=generate-another-random-value-at-least-32-characters
OMNI_S3_BUCKET=omni-attachments

# Application secrets. Each must be independent and at least 32 characters.
OMNI_JWT_SECRET=generate-a-random-value-at-least-32-characters
OMNI_VOICE_WEBHOOK_SECRET=generate-a-random-value-at-least-32-characters
OMNI_VOICE_MEDIA_SECRET=generate-a-random-value-at-least-32-characters

# Development login is for IP-restricted staging only. Keep false for a public deployment.
OMNI_ALLOW_DEV_AUTH=false

# Gemini stays server-side and must never use a VITE_ prefix.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GOOGLE_GEMINI_BASE_URL=
OMNI_AI_PROVIDER=gemini
OMNI_AI_MODEL=gemini-3.5-flash-lite
OMNI_GEMINI_STT_MODEL=gemini-3.5-flash-lite
OMNI_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
OMNI_GEMINI_TTS_VOICE=Kore

# Keep concurrency conservative on a 4 GB staging host.
OMNI_AI_RUNS_PER_MINUTE=30
OMNI_AI_TIMEOUT_SECONDS=30
OMNI_VOICE_MAX_GATEWAY_SESSIONS=5
