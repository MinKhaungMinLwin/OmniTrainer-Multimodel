# This is the API key for a user of your app. For now it can be anything
# you want, but cannot be empty
USER_API_KEY="change-me"

GEMINI_API_KEY="your-gemini-api-key"
# This is specific for running things in Udacity, remove for normal gemini
# from Google AI Studio
# Leave blank for Google AI Studio. Set the Udacity proxy only when using its issued key.
GOOGLE_GEMINI_BASE_URL=""
DEFAULT_GOOGLE_MODEL="gemini-3.5-flash-lite"

# Model used as judge in evaluations (can be same or different from DEFAULT_GOOGLE_MODEL)
# You might want to use a more powerful model as judge, e.g., "gemini-2.0-flash-exp"
EVAL_JUDGE_MODEL="gemini-3.5-flash-lite"

# Number of times to repeat each test case (for measuring LLM consistency)
# Set to 1 for quick runs, 5-10 for statistical confidence
EVAL_NUM_REPEATS=5

# Local service URLs
API_BASE_URL="http://localhost:8000"
PHOENIX_URL="http://127.0.0.1:6006"

# Omni platform service
OMNI_ENVIRONMENT="development"
OMNI_DATABASE_URL="postgresql+asyncpg://omni:omni@localhost:5432/omni"
OMNI_REDIS_URL="redis://localhost:6379/0"
OMNI_JWT_SECRET="replace-with-at-least-32-random-characters"
OMNI_ALLOW_DEV_AUTH=true
OMNI_CORS_ORIGINS='["http://localhost:5173","http://localhost:8081"]'
OMNI_STORAGE_BACKEND="local"
OMNI_ATTACHMENT_DIR="./data/attachments"
OMNI_S3_ENDPOINT_URL="http://localhost:9000"
OMNI_S3_ACCESS_KEY="omni"
OMNI_S3_SECRET_KEY="omni-development-password"
OMNI_S3_BUCKET="omni-attachments"
# Set to AES256 when the deployment's S3-compatible store has SSE configured.
OMNI_S3_SERVER_SIDE_ENCRYPTION=""
OMNI_AI_PROVIDER="local"
OMNI_AI_MODEL="omni-copilot-local-v1"
OMNI_AI_RUNS_PER_MINUTE=30
OMNI_AI_TIMEOUT_SECONDS=15
OMNI_TRACING_ENABLED=false
OMNI_TRACING_ENDPOINT="http://localhost:6006/v1/traces"
OMNI_TRACING_PUBLIC_URL="http://localhost:6006"
OMNI_TRACING_API_KEY=""
OMNI_TRACING_PROJECT_NAME="omni-development"
OMNI_TRACING_SAMPLE_RATIO=1.0
# Keep false unless the trace backend is approved to store prompts and outputs.
OMNI_TRACING_CAPTURE_CONTENT=false
OMNI_GEMINI_STT_MODEL="gemini-3.5-flash-lite"
OMNI_GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
OMNI_GEMINI_TTS_VOICE="Kore"
OMNI_AI_MAX_AUDIO_BYTES=10485760
OMNI_VOICE_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
OMNI_VOICE_MEDIA_SECRET="replace-with-a-random-media-token-secret"
OMNI_VOICE_PUBLIC_BASE_URL="http://localhost:8002"
OMNI_VOICE_MAX_RECORDING_BYTES=5242880
OMNI_VOICE_TARGET_FIRST_AUDIO_MS=800
OMNI_VOICE_WEBHOOK_TOLERANCE_SECONDS=300
OMNI_VOICE_MAX_FRAME_BYTES=65536
OMNI_VOICE_MAX_BUFFERED_FRAMES=50
OMNI_VOICE_STALE_FRAME_MS=2000
OMNI_VOICE_STAGE_TIMEOUT_MS=1500
OMNI_VOICE_CIRCUIT_FAILURE_THRESHOLD=3
OMNI_VOICE_CIRCUIT_RESET_SECONDS=30
OMNI_VOICE_MAX_GATEWAY_SESSIONS=500
